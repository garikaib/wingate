{
    "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
    "version": 3,
    "settings": {
        "layout": {
            "contentSize": "1280px",
            "wideSize": "100%"
        },
        "color": {
            "palette": [
                {
                    "color": "#0e1b3d",
                    "name": "Brand Blue",
                    "slug": "brand-blue"
                },
                {
                    "color": "#ffcc00",
                    "name": "Brand Yellow",
                    "slug": "brand-yellow"
                },
                {
                    "color": "#f5f5f5",
                    "name": "Brand Gray",
                    "slug": "brand-gray"
                },
                {
                    "color": "#FFFFFF",
                    "name": "White",
                    "slug": "white"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "text": "var:preset|color|brand-blue",
            "background": "var:preset|color|white"
        },
        "elements": {
            "link": {
                "typography": {
                    "textDecoration": "none"
                },
                ":hover": {
                    "typography": {
                        "textDecoration": "none"
                    }
                }
            }
        }
    }
}